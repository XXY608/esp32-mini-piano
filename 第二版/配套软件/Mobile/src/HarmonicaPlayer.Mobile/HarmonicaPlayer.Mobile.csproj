<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>HarmonicaPlayer.Mobile</RootNamespace>
    <ApplicationTitle>电子琴</ApplicationTitle>
    <ApplicationId>com.harmonicaplayer.electrickeyboard</ApplicationId>
    <ApplicationDisplayVersion>0.3.12</ApplicationDisplayVersion>
    <ApplicationVersion>23</ApplicationVersion>
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>21.0</TargetPlatformMinVersion>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
    <!-- Keep the debug Android keystore inside the project build folder. -->
    <AppSettingsDirectory>$(MSBuildProjectDirectory)\obj\android-settings\</AppSettingsDirectory>
  </PropertyGroup>

  <!--
    Keep the sideloaded Release APK on the same conservative Android runtime
    path as the working Visual Studio debug deployment. This avoids native
    startup crashes on the target phone while communication is being tested.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <AndroidLinkMode>None</AndroidLinkMode>
    <PublishTrimmed>false</PublishTrimmed>
    <AndroidUseAssemblyStore>false</AndroidUseAssemblyStore>
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <UseInterpreter>true</UseInterpreter>
    <AndroidUseInterpreter>true</AndroidUseInterpreter>
    <!-- Honor Android's requirement that native .so files remain uncompressed. -->
    <AndroidStoreUncompressedFileExtensions>.so;$(AndroidStoreUncompressedFileExtensions)</AndroidStoreUncompressedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HarmonicaPlayer.Mobile.Core\HarmonicaPlayer.Mobile.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#1D3557" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1D3557" BaseSize="128,128" />
  </ItemGroup>
</Project>
